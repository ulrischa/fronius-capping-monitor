[Unit]
Description=Fronius Curtailment Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fronius-monitor
Group=fronius-monitor
WorkingDirectory=/opt/fronius-monitor
Environment=NODE_ENV=production
Environment=FRONIUS_MONITOR_CONFIG=/etc/fronius-monitor/config.json
ExecStart=@NODE_PATH@ /opt/fronius-monitor/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/fronius-monitor

[Install]
WantedBy=multi-user.target
